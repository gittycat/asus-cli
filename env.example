# Router credentials.
#
# Copy this to ONE of the following (first match wins):
#   $ASUSWRT_ENV_FILE        if you set that variable
#   ./.env                   for a repo-local checkout
#   ~/.config/asuswrt/.env   recommended when installed globally
#
# The MCP server reads the same file, from the same three locations.
#
# Use the same admin account you log into the ASUS Router app with.

ROUTER_HOST=192.168.50.1
ROUTER_USER=admin
ROUTER_PASS=

# Set to true only if you enabled HTTPS on the web UI
ROUTER_SSL=false

# Only needed for a non-default port (80 / 8443)
# ROUTER_PORT=8443
